# Two vLLM installs of the same upstream-main commit, for the peer lookup
# compatibility run (peer_lookup_compat.yaml, peer_lookup_unit_tests.yaml):
#
#   /opt/venv       main + the local review-fix files, copied over it from
#                   ./local_vllm.tar.gz (examples/kv-transfer/prepare_local_vllm.sh).
#                   This is the engine under test, and the unit tests run in it.
#   /opt/venv-main  stock main, no peer lookup: the "old" engine. Its
#                   side-channel listener is the one that dies on a LOOKUP_PIN
#                   frame.
#
# Both reuse the kernels of main's nightly wheel (VLLM_USE_PRECOMPILED), which
# match because the review fixes change Python only. VLLM_SHA is main's commit,
# resolved from `sources` in the experiment file.
FROM nvidia/cuda:13.2.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/0.12.5/install.sh | env UV_UNMANAGED_INSTALL=/usr/local/bin sh \
    && uv venv /opt/venv --python 3.12 \
    && uv pip install --python /opt/venv/bin/python pip \
    && uv venv /opt/venv-main --python 3.12 \
    && uv pip install --python /opt/venv-main/bin/python pip
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin

RUN uv pip install --python /opt/venv/bin/python nixl==1.5.2 datasets \
        pytest pytest-asyncio tblib ray \
    && uv pip install --python /opt/venv-main/bin/python nixl==1.5.2

ARG VLLM_REPO
ARG VLLM_SHA
RUN VLLM_USE_PRECOMPILED=1 uv pip install --python /opt/venv-main/bin/python \
        "vllm @ git+${VLLM_REPO}@${VLLM_SHA}"
RUN VLLM_USE_PRECOMPILED=1 uv pip install --python /opt/venv/bin/python \
        "vllm @ git+${VLLM_REPO}@${VLLM_SHA}"

# The review-fix files over /opt/venv's vllm, and the tests beside them. The
# build context is this directory, so run prepare_local_vllm.sh first. A change
# there only rebuilds from here.
COPY local_vllm.tar.gz /tmp/local_vllm.tar.gz
RUN mkdir -p /tmp/local_vllm /opt/vllm-tests \
    && tar -xzf /tmp/local_vllm.tar.gz -C /tmp/local_vllm \
    && mv /tmp/local_vllm/tests /opt/vllm-tests/tests \
    && cp /tmp/local_vllm/HEAD_SHA /opt/vllm-tests/HEAD_SHA \
    && cp /tmp/local_vllm/BASE_SHA /tmp/BASE_SHA
RUN test "$(cat /tmp/BASE_SHA)" = "${VLLM_SHA}" \
    || { echo "overlay base $(cat /tmp/BASE_SHA) != VLLM_SHA ${VLLM_SHA}" >&2; exit 1; }
RUN cp -r /tmp/local_vllm/vllm/. /opt/venv/lib/python3.12/site-packages/vllm/ \
    && rm -rf /tmp/local_vllm /tmp/local_vllm.tar.gz

COPY sitecustomize.py /opt/nixl-error-mode/sitecustomize.py
