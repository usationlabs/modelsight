# The peer-stage image plus RDMA userspace, for the two-node H6 runs
# (rdma_smoke.yaml, h6*.yaml). Everything down to the vLLM overlay is
# Dockerfile.peer_stage (upstream main at VLLM_SHA with the files of the local
# peer-stage worktree from ./local_vllm_peer_stage.tar.gz laid over its
# precompiled install; run prepare_local_vllm.sh first, see the experiment
# headers). It is repeated here because a Dockerfile cannot extend another one.
#
# Added: rdma-core and the verbs tools (ib_write_bw, ibv_devinfo) so the
# containers can talk RDMA, and ucx-utils (ucx_info, ucx_perftest) for the
# smoke test. The nixl wheel brings its own UCX; the apt one is only a tool.
# Which UCX NIXL loads, and whether it has IB transports, is printed at build
# time (ucx_report.sh). There is no IB device while building, so that report
# shows modules and linked libraries, not devices; the device list is printed
# again by rdma_smoke.yaml on a real node.

FROM nvidia/cuda:13.2.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl ca-certificates git \
        rdma-core ibverbs-providers libibverbs1 ibverbs-utils perftest infiniband-diags \
        ucx-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/0.12.5/install.sh | env UV_UNMANAGED_INSTALL=/usr/local/bin sh \
    && uv venv /opt/venv --python 3.12 \
    && uv pip install --python /opt/venv/bin/python pip
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin

RUN uv pip install --python /opt/venv/bin/python nixl==1.5.2 datasets \
        pytest pytest-asyncio tblib ray

ARG VLLM_REPO
ARG VLLM_SHA
RUN VLLM_USE_PRECOMPILED=1 uv pip install --python /opt/venv/bin/python \
        "vllm @ git+${VLLM_REPO}@${VLLM_SHA}"

# The branch's files over the install, and the tests beside them. The build
# context is this directory, so run prepare_local_vllm.sh first. A change there
# only rebuilds from here.
COPY local_vllm_peer_stage.tar.gz /tmp/local_vllm.tar.gz
RUN mkdir -p /tmp/local_vllm /opt/vllm-tests \
    && tar -xzf /tmp/local_vllm.tar.gz -C /tmp/local_vllm \
    && mv /tmp/local_vllm/tests /opt/vllm-tests/tests \
    && cp /tmp/local_vllm/HEAD_SHA /opt/vllm-tests/HEAD_SHA \
    && cp /tmp/local_vllm/BASE_SHA /tmp/BASE_SHA
RUN test "$(cat /tmp/BASE_SHA)" = "${VLLM_SHA}" \
    || { echo "overlay base $(cat /tmp/BASE_SHA) != VLLM_SHA ${VLLM_SHA}" >&2; exit 1; }
RUN cp -r /tmp/local_vllm/vllm/. /opt/venv/lib/python3.12/site-packages/vllm/ \
    && rm -rf /tmp/local_vllm /tmp/local_vllm.tar.gz

# UCX error handling "none" for every Python process (Modal has no tcp/RDMA for
# the default "peer" mode); the peer_stage_hook sitecustomize loads it too.
COPY sitecustomize.py /opt/nixl-error-mode/sitecustomize.py

# What UCX can this image use? Prints the system UCX (apt) and the UCX the nixl
# wheel ships (found by file name under site-packages: if the wheel keeps its
# UCX elsewhere the report says so, and then look at `pip show -f nixl`).
COPY ucx_report.sh /opt/ucx_report.sh
# The H6 server script: only the modelsight package is mounted, not examples/.
COPY h6_server.sh /opt/h6_server.sh
RUN bash /opt/ucx_report.sh; ibv_devinfo || true

# Not enabled: a UCX built with verbs and mlx5 for NIXL, if the report above
# shows the wheel's UCX has no rc/dc transports (no libuct_ib*.so, or its
# libibverbs/libmlx5 are "not found"). The wheel's libraries are renamed by
# auditwheel, so LD_LIBRARY_PATH cannot replace them; NIXL has to be rebuilt
# against this UCX. Uncomment, rebuild, and read the report again.
# ARG UCX_VERSION=1.19.0
# ARG NIXL_VERSION=1.5.2
